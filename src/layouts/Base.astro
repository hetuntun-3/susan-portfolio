---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  caseSlug?: string; // set on case-study pages for analytics
}
const { title, description = site.description, caseSlug } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · Marketing, insight & analytics`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/work', label: 'work' },
  { href: '/lab', label: 'lab' },
  { href: '/about', label: 'about' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const caseNames: Record<string, string> = { insta360: 'Insta360', dreame: 'Dreame' };
const caseName = caseSlug ? caseNames[caseSlug] : undefined;
const gaOn = site.gaId && !site.gaId.includes('XXXX');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,600..700,50&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');document.documentElement.dataset.reveal='.reveal, .idea-card, .stat, .section-lead, .now-row, .section-head, .card, .tools-group, .lab-card, .timeline li, .prose > *, .tldr, .case-head .container > *, .about-open .container > *, .intro .container > *, .cta-band .container > *, .contact-list li, .say-hi-line, .case-nav, .think-item, .band';</script>
    {gaOn && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
        <script is:inline define:vars={{ id: site.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body data-case={caseSlug}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <div class="crumbs">
          <a class="wordmark" href="/">{site.wordmark}</a>
          {caseName && <span class="crumb-trail" aria-label="You are here"><span aria-hidden="true">/</span><a href="/work">work</a><span aria-hidden="true">/</span><span class="crumb-current">{caseName}</span></span>}
        </div>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={site.resumePdf} download="Susan-Su-Resume.pdf" data-ga="resume_download">resume</a>
        </nav>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">menu</button>
      </div>
    </header>
    <div class="mobile-nav" id="mobile-nav" role="dialog" aria-label="Menu">
      <div class="mobile-nav-top">
        <div class="crumbs">
          <a class="wordmark" href="/">{site.wordmark}</a>
          {caseName && <span class="crumb-trail" aria-label="You are here"><span aria-hidden="true">/</span><a href="/work">work</a><span aria-hidden="true">/</span><span class="crumb-current">{caseName}</span></span>}
        </div>
        <button class="menu-btn close-btn" type="button">close</button>
      </div>
      <a class="m-link" href="/" aria-current={path === '/' ? 'page' : undefined}>home</a>
      {nav.map((n) => (
        <a class="m-link" href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="m-link" href={site.resumePdf} download="Susan-Su-Resume.pdf" data-ga="resume_download">resume ↓</a>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-boxes">
          <div class="footer-box">© 2026 {site.name}</div>
          <div class="footer-box contact">
            contact: <a href={`mailto:${site.email}`} data-ga="contact_click" data-ga-method="email">{site.email}</a>
            {' · '}
            <a href={site.linkedin} target="_blank" rel="noopener" data-ga="contact_click" data-ga-method="linkedin">LinkedIn</a>
          </div>
          <div class="footer-box">built with Claude</div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu
      const menu = document.getElementById('mobile-nav');
      const openBtn = document.querySelector<HTMLButtonElement>('.site-header .menu-btn');
      const closeBtn = document.querySelector<HTMLButtonElement>('.close-btn');
      const setOpen = (open: boolean) => {
        menu?.classList.toggle('open', open);
        openBtn?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) closeBtn?.focus(); else openBtn?.focus();
      };
      openBtn?.addEventListener('click', () => setOpen(true));
      closeBtn?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu?.classList.contains('open')) setOpen(false); });

      // Scroll reveal: each block rises and fades in as it enters the screen.
      // The list of revealed elements lives in global.css (search "scroll reveal").
      const revealSel = document.documentElement.dataset.reveal || '';
      const targets = Array.from(document.querySelectorAll<HTMLElement>(revealSel));
      // stagger items that sit side by side (cards, chips rows, timeline)
      targets.forEach((el) => {
        if (el.matches('.card, .lab-card, .timeline li, .tools-group, .idea-card, .stat')) {
          const sibs = Array.from(el.parentElement?.children ?? []);
          el.style.transitionDelay = `${(sibs.indexOf(el) % 3) * 110}ms`;
        }
        el.addEventListener('transitionend', (ev) => {
          if (ev.target === el && el.classList.contains('in')) { el.classList.add('done'); el.style.transitionDelay = ''; }
        });
      });
      const countUp = (el: HTMLElement) => {
        el.querySelectorAll<HTMLElement>('.count').forEach((c) => {
          const to = Number(c.dataset.to || 0);
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { c.textContent = String(to); return; }
          const start = performance.now(), dur = 1400;
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / dur);
            c.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 4))));
            if (p < 1) requestAnimationFrame(tick);
          };
          c.textContent = '0';
          requestAnimationFrame(tick);
        });
      };
      const show = (el: HTMLElement) => {
        if (el.classList.contains('stat')) countUp(el);
        el.classList.add('in');
        setTimeout(() => el.classList.add('done'), 1800); // safety net
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { show(en.target as HTMLElement); io.unobserve(en.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach(show);
      }

      // Respect "reduce motion": don't autoplay looping clips
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); v.controls = true; });
      }

      // Analytics (GA4). Events only send once a real GA4 ID is set in src/data/site.json.
      const send = (name: string, params: Record<string, string> = {}) => {
        const g = (window as any).gtag;
        if (typeof g === 'function') g('event', name, params);
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-ga]');
        if (!el) return;
        const params: Record<string, string> = {};
        if (el.dataset.gaMethod) params.method = el.dataset.gaMethod;
        if (el.dataset.gaProject) params.project = el.dataset.gaProject;
        send(el.dataset.ga!, params);
      });
      const caseSlug = document.body.dataset.case;
      if (caseSlug) {
        send('case_study_view', { case: caseSlug });
        let sent = false;
        window.addEventListener('scroll', () => {
          if (sent) return;
          const depth = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
          if (depth >= 0.9) { sent = true; send('scroll_depth_90', { case: caseSlug }); }
        }, { passive: true });
      }
    </script>
  </body>
</html>
