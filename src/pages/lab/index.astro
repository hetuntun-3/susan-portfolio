---
import Base from '../../layouts/Base.astro';
import TitleBar from '../../components/TitleBar.astro';
import { getCollection } from 'astro:content';
import { hasBody } from '../../lib/lab';

const all = (await getCollection('lab', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const lab = all.filter((e) => e.data.kind === 'lab');
const writing = all.filter((e) => e.data.kind === 'writing');
---
<Base title="Lab & writing" description="Analytics projects I'm building at Columbia, and cultural writing on Gen Z, wellness and brands.">
  <TitleBar title="lab & writing" subtitle="where I test what I'm learning" />

  <div class="container">
    <p class="hero-intro" style="margin-top: var(--s-8)">
      My internships taught me why people buy. At Columbia I'm learning to prove it: Python, regression, experiment design, web scraping, and SQL. This is where those projects live as I build them.
    </p>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>lab</h2>
        <span class="label">analytics projects</span>
      </div>
      <div class="lab-list" style="--block: var(--block-lab)">
        {lab.map((e) => {
          const d = e.data;
          const linked = hasBody(e) || d.status === 'published';
          const Tag = linked ? 'a' : 'div';
          return (
            <Tag class="lab-card" href={linked ? `/lab/${e.id}` : undefined} data-ga={linked ? 'lab_project_click' : undefined} data-ga-project={e.id}>
              <div class="lab-meta">
                <span class={`badge ${d.status === 'published' ? 'published' : 'progress'}`}>
                  {d.status === 'published' ? 'Published' : 'In progress'}
                </span>
                {d.statusNote && <span class="label">{d.statusNote}</span>}
              </div>
              <h3>{d.title}</h3>
              <p>{d.summary}</p>
              <ul class="chips small">{d.skills.map((s) => <li class="chip">{s}</li>)}</ul>
              {linked && <span class="lab-link">Read more →</span>}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>writing</h2>
        <span class="label">cultural insight</span>
      </div>
      <div class="lab-list writing-list" style="--block: var(--block-writing)">
        {writing.map((e) => {
          const d = e.data;
          const Tag = d.link ? 'a' : 'article';
          return (
            <Tag class="lab-card writing-card" href={d.link} target={d.link ? '_blank' : undefined} rel={d.link ? 'noopener noreferrer' : undefined} data-ga={d.link ? 'lab_project_click' : undefined} data-ga-project={e.id}>
              {d.cover && <div class={`writing-cover ${d.coverStyle ?? ''}`}>
                <img src={d.cover} alt={d.coverAlt ?? ''} width="1400" height="788" loading="lazy" decoding="async" />
                {d.coverStyle === 'video' && <span class="writing-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="25" height="25"><path d="M8 4.5v15l12-7.5z" fill="currentColor" /></svg></span>}
                <span class="writing-cover-label" aria-hidden="true">{d.coverStyle === 'video' ? 'Watch on YouTube ↗' : 'Open full zine ↗'}</span>
              </div>}
              <div class="writing-copy">
                <span class="micro">{d.type}</span>
                <h3>{d.title}</h3>
                <p>{d.summary}</p>
                {d.credit && <span class="writing-credit">{d.credit}</span>}
                {d.link ? <span class="lab-link">{d.linkLabel ?? 'Open ↗'}<span class="sr-only"> (opens in a new tab)</span></span> : d.linkPending && <span class="lab-link label">{d.linkPending}</span>}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
</Base>
