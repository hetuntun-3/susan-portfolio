---
import Base from '../layouts/Base.astro';
import TitleBar from '../components/TitleBar.astro';
import IdeaCards from '../components/IdeaCards.astro';
import site from '../data/site.json';
import { getEntry } from 'astro:content';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const d = about.data;
// fixed tilts so photos look the same on every load
const tilts = [-1.5, 1.2, -0.6, 1.8, -1.9, 0.8];
---
<Base title="About" description="Susan Su: Gender Studies at UCLA, Marketing Science at Columbia. Why I think culture and data belong together in marketing.">
  <TitleBar title={d.title} subtitle={d.subtitle} />

  <section class="about-open">
    <div class="container">
      <h2>{d.opening}</h2>
      <p>{d.intro}</p>
      {d.introExtra && <p class="about-extra">{d.introExtra}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>my path</h2><span class="label">past = insight · now = measurement</span></div>
      <ol class="timeline">
        {d.timeline.map((t) => (
          <li class={t.highlight ? 'hl' : undefined}>
            <span class="label">{t.when}</span>
            <div class="where">{t.where}</div>
            <p class="added">{t.added}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {d.habits.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>what gender studies gave me</h2><span class="label">three habits I bring to every project</span></div>
        {d.habitsIntro && <p class="section-lead">{d.habitsIntro}</p>}
        <IdeaCards items={d.habits} />
      </div>
    </section>
  )}

  {d.now.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>right now</h2><span class="label">fall 2026</span></div>
        <dl class="now-list">
          {d.now.map((n) => (
            <div class="now-row">
              <dt class="micro">{n.label}</dt>
              <dd>{n.link ? <a href={n.link}>{n.value} →</a> : n.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>outside work</h2><span class="label">where I recharge</span></div>
      {d.outside && <p class="section-lead">{d.outside}</p>}
      {d.photos.length > 0 && (
        <div class="photo-grid">
          {d.photos.map((p, i) => (
            <figure class="polaroid" style={`margin:0; transform: rotate(${tilts[i % tilts.length]}deg)`}>
              {p.video && <span class="clip-badge" aria-hidden="true">▶ video</span>}
              {p.video ? (
                <video class="about-clip" src={p.video} poster={p.src} muted loop playsinline autoplay preload="metadata" aria-label={p.alt} style={p.position ? `object-position:${p.position}` : undefined}></video>
              ) : (
                <img src={p.src} alt={p.alt} loading="lazy" style={p.position ? `object-position:${p.position}` : undefined} />
              )}
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section say-hi" id="contact">
    <div class="container">
      <p class="say-hi-line">{d.sayHi ?? "Want a hiking buddy, a dive partner, or a bartender for your startup's next party? Say hi."}</p>
      <a class="say-hi-link" href={`mailto:${site.email}`} data-ga="contact_click" data-ga-method="email">{site.email} →</a>
    </div>
  </section>
</Base>
