---
import Base from '../layouts/Base.astro';
import TitleBar from '../components/TitleBar.astro';
import site from '../data/site.json';
// To update: replace public/Susan-Su-Resume.pdf with the new file (same name).
---
<Base title="Resume" description="Susan Su's resume: Columbia Business School MS Marketing Science; Insta360, Dreame and SHEIN.">
  <TitleBar title="resume" subtitle="one page, updated Oct 2026" />
  <section class="section" style="padding-top: var(--s-7)">
    <div class="container">
      <div class="btn-row">
        <a class="btn btn-primary" href={site.resumePdf} download data-ga="resume_download">Download PDF</a>
        <a class="btn btn-secondary" href={site.resumePdf} target="_blank" rel="noopener" data-ga="resume_download">Open in a new tab</a>
      </div>
      <iframe class="resume-frame" src={`${site.resumePdf}#view=FitH`} title="Susan Su resume (PDF)"></iframe>
    </div>
  </section>
</Base>
