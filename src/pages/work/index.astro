---
import Base from '../../layouts/Base.astro';
import TitleBar from '../../components/TitleBar.astro';
import WorkProjects from '../../components/WorkProjects.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', (e) => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" description="Case studies from Insta360 and Dreame: rider selection, launch decks, creators, social plans and press data.">
  <TitleBar title="work" subtitle="case studies, newest first" />
  <section class="section" style="padding-top: var(--s-8)">
    <div class="container">
      <WorkProjects entries={work} />
    </div>
  </section>
</Base>
