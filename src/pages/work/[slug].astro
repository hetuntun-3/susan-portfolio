---
import Base from '../../layouts/Base.astro';
import DreameStory from '../../components/DreameStory.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = (await getCollection('work', (e) => !e.data.draft && !e.data.comingSoon))
    .sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
// Lets you write **bold** inside TL;DR values in the front-matter
const md = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<Base title={d.headline ?? d.title} description={d.description ?? d.lead} caseSlug={entry.id}>
  <article class={entry.id === 'insta360' ? 'insta-case' : entry.id === 'dreame' ? 'dreame-case' : undefined} style={`--block: var(--block-${d.block})`}>
    <header class="case-head">
      <div class="container">
        <a class="back-link" href="/work">← all work</a>
        {entry.id === 'dreame' && <p class="micro dreame-kicker">Dreame · U.S. Back-to-School</p>}
        <h1>{entry.id === 'dreame' ? <>One season.<br />Two audiences.</> : d.headline}</h1>
        {d.lead && <p class="lead">{d.lead}</p>}
      </div>
    </header>

    {entry.id === 'insta360' && <div class="container case-output-strip" aria-label="My contributions">
      <div><strong>100</strong><span>camera riders selected</span></div>
      <div><strong>2</strong><span>audience workshop decks</span></div>
      <div><strong>18</strong><span>creator demos curated</span></div>
    </div>}
    {entry.id === 'dreame' && <DreameStory><Content /></DreameStory>}
    <div class="container reading">
      {d.tldr.length > 0 && (
        <section class="tldr" aria-label="TL;DR">
          <div class="tldr-title micro">TL;DR · {d.title}</div>
          <dl>
            {d.tldr.map((r) => (
              <div class="tldr-row">
                <dt>{r.label}</dt>
                <dd set:html={md(r.value)} />
              </div>
            ))}
          </dl>
        </section>
      )}

      {entry.id !== 'dreame' && <div class="prose">
        <Content />
      </div>}

      <nav class="case-nav" aria-label="More case studies">
        {prev && (
          <a class="prev" href={`/work/${prev.id}`}><span class="label">← previous case</span>{prev.data.title}</a>
        )}
        {next && (
          <a class="next" href={`/work/${next.id}`}><span class="label">next case →</span>{next.data.title}</a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .dreame-case .case-head .container { max-width:1120px; }
  .dreame-kicker { margin:24px 0 12px; }
  .dreame-case .case-head h1 { font-size:clamp(38px,5.5vw,64px); max-width:18ch; margin:0 0 20px; }
  .dreame-case .case-head .lead { max-width:64ch; }
  .dreame-case .case-head { padding-bottom:28px; }
</style>
