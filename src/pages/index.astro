---
import Base from '../layouts/Base.astro';
import WorkProjects from '../components/WorkProjects.astro';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';
import { getCollection, getEntry } from 'astro:content';

const work = (await getCollection('work', (e) => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const h = site.hero;
const about = await getEntry('pages', 'about');
---
<Base>
<div class="home chapter-home">
  <!-- Hero: name, one short line, photo -->
  <section class="splash home-chapter" id="intro" aria-label="Introduction" style="--chapter-order: 1">
    <div class="chapter-content hero-content">
    <div class="container splash-grid">
      <div class="splash-text">
        <h1 class="splash-name" aria-label={site.name}>
          {site.name.split('').map((c, i) => (
            <span class="ch" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? '\u00a0' : c}</span>
          ))}
        </h1>
        <p class="splash-headline">{h.headline}</p>
        <div class="hero-details"><p>{h.kicker}</p><p>Open to summer 2027 internships</p><p class="hero-roles">Growth / Product Marketing / Marketing Analytics</p></div>
        <a class="splash-link" href="#work">see my work ↓</a>
      </div>
      <figure class={`polaroid splash-photo${h.headshot ? '' : ' no-photo'}`} style="margin:0">
        {h.headshot ? (
          <img src={h.headshot} alt={h.headshotAlt} />
        ) : (
          <div class="ph">headshot<br />coming soon</div>
        )}
        <figcaption>susan · new york</figcaption>
      </figure>
    </div>
    </div>
    <div class="container chapter-foot"><span>01 / 04 · introduction</span><a href="#work">scroll to uncover ↓</a></div>
  </section>

  <!-- Work -->
  <section class="home-block home-chapter work-chapter" id="work" aria-labelledby="work-title" style="--chapter-order: 2">
    <div class="chapter-content">
    <div class="band"><div class="container"><h2 id="work-title">selected work</h2><span class="label">ideas → decisions → execution</span></div></div>
    <div class="container">
      <WorkProjects entries={work} />
    </div>
    </div>
    <div class="container chapter-foot"><span>02 / 04 · selected work</span><a href="#thinking">how i think ↓</a></div>
  </section>

  <!-- How I think: titles only (full text lives in src/content/pages/about.md) -->
  {about && about.data.beliefs.length > 0 && (
    <section class="home-block home-chapter thinking-chapter" id="thinking" aria-labelledby="thinking-title" style="--chapter-order: 3">
      <div class="chapter-content">
      <div class="band"><div class="container"><h2 id="thinking-title">how i think</h2><span class="label">{about.data.beliefsIntro}</span></div></div>
      <div class="container">
        <ul class="think-list">
          {about.data.beliefs.map((b) => (
            <li class="idea-card think-item"><Icon name={b.icon} /><span>{b.title}</span></li>
          ))}
        </ul>
      </div>
      </div>
      <div class="container chapter-foot"><span>03 / 04 · how i think</span><a href="#skills">skills ↓</a></div>
    </section>
  )}

  <!-- Skills -->
  <section class="home-block home-chapter skills-chapter" id="skills" aria-labelledby="skills-title" style="--chapter-order: 4">
    <div class="chapter-content">
    <div class="band"><div class="container"><h2 id="skills-title">skills</h2><span class="label">dashed = learning now</span></div></div>
    <div class="container">
      <div class="tools-group">
        <h3>Tools</h3>
        <ul class="chips">{site.skills.tools.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
      <div class="tools-group">
        <h3>Learning</h3>
        <ul class="chips">{site.skills.learning.map((s) => <li class="chip learning">{s}</li>)}</ul>
      </div>
      <div class="tools-group">
        <h3>Certified</h3>
        <ul class="chips">{site.skills.certified.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </div>
    </div>
    <div class="container chapter-foot"><span>04 / 04 · skills</span><a href={`mailto:${site.email}`}>let’s talk ↗</a></div>
  </section>

  <section class="home-block home-end">
    <div class="container">
      <p>{site.cta.line} <a href={`mailto:${site.email}`} data-ga="contact_click" data-ga-method="email">email me →</a></p>
    </div>
  </section>
</div>
<script>
  // Native sticky sheets retain normal wheel, touch, keyboard, and anchor scrolling.
  const home = document.querySelector<HTMLElement>('.chapter-home');
  if (home) {
    const chapters = Array.from(home.querySelectorAll<HTMLElement>('.home-chapter'));
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    const starts = new Map<HTMLElement, number>();
    let frame = 0;
    const paint = () => {
      frame = 0;
      const viewport = window.innerHeight;
      chapters.forEach((chapter, index) => {
        const next = chapters[index + 1];
        const progress = next ? Math.max(0, Math.min(1, 1 - next.getBoundingClientRect().top / viewport)) : 0;
        chapter.style.setProperty('--chapter-exit', motion.matches ? progress.toFixed(4) : '0');
      });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(paint); };
    const measure = () => {
      let start = home.getBoundingClientRect().top + window.scrollY;
      chapters.forEach((chapter) => {
        starts.set(chapter, start);
        start += chapter.offsetHeight;
        // A tall chapter scrolls to its last line before the following sheet covers it.
        chapter.style.setProperty('--chapter-top', `${Math.min(0, window.innerHeight - chapter.offsetHeight)}px`);
      });
      home.classList.toggle('chapters-ready', motion.matches);
      schedule();
    };
    const observer = new ResizeObserver(measure);
    chapters.forEach((chapter) => observer.observe(chapter));
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    motion.addEventListener('change', measure);
    // Keep normal document flow while tabbing, so covered links remain reachable.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') home.classList.add('keyboard-navigation');
    });
    document.addEventListener('pointerdown', () => home.classList.remove('keyboard-navigation'), { passive: true });
    const scrollToChapter = (hash: string, behavior: ScrollBehavior) => {
      const chapter = chapters.find((item) => `#${item.id}` === hash);
      if (!chapter) return false;
      window.scrollTo({ top: starts.get(chapter) ?? 0, behavior });
      return true;
    };
    home.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      if (scrollToChapter(link.hash, motion.matches ? 'smooth' : 'instant')) {
        event.preventDefault();
        history.pushState(null, '', link.hash);
      }
    });
    window.addEventListener('hashchange', () => scrollToChapter(location.hash, 'instant'));
    measure();
    document.fonts.ready.then(() => {
      measure();
      if (location.hash) scrollToChapter(location.hash, 'instant');
    });
  }
</script>
</Base>
