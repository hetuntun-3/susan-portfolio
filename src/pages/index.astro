---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

const work = (await getCollection('work', (e) => !e.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((e) => e.data.featured && !e.data.comingSoon);
const h = site.hero;
---
<Base>
  <!-- Screen 1: name + keywords -->
  <section class="splash">
    <div class="container splash-grid">
      <div class="splash-text">
        <p class="label splash-kicker">{h.kicker}</p>
        <h1 class="splash-name" aria-label={site.name}>
          {site.name.split('').map((c, i) => (
            <span class="ch" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? '\u00a0' : c}</span>
          ))}
        </h1>
        <ul class="splash-keywords">
          {h.keywords.map((k) => <li>{k}</li>)}
        </ul>
      </div>
      <figure class={`polaroid splash-photo${h.headshot ? '' : ' no-photo'}`} style="margin:0">
        {h.headshot ? (
          <img src={h.headshot} alt={h.headshotAlt} />
        ) : (
          <div class="ph">headshot<br />coming soon</div>
        )}
        <figcaption>susan · new york</figcaption>
      </figure>
    </div>
    <a class="scroll-cue label" href="#intro">scroll ↓</a>
  </section>

  <!-- Screen 2: the pitch -->
  <section class="intro" id="intro">
    <div class="container">
      <h2 class="intro-headline">{h.headline}</h2>
      <p class="hero-intro">{h.intro}</p>
      <p class="label hero-avail">{h.availability}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/work">See my work</a>
        <a class="btn btn-secondary" href={site.resumePdf} download="Susan-Su-Resume.pdf" data-ga="resume_download">Resume</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>featured work</h2>
        <a class="label" href="/work">all case studies →</a>
      </div>
      <div class="card-grid">
        {featured.map((e) => <ProjectCard entry={e} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>tools</h2>
      </div>
      <div class="tools-group">
        <span class="micro">Tools</span>
        <ul class="chips">{site.skills.tools.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
      <div class="tools-group">
        <span class="micro">Currently learning</span>
        <ul class="chips">{site.skills.learning.map((s) => <li class="chip learning">{s}</li>)}</ul>
      </div>
      <div class="tools-group">
        <span class="micro">Certified</span>
        <ul class="chips">{site.skills.certified.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <p>{site.cta.line}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={`mailto:${site.email}`} data-ga="contact_click" data-ga-method="email">Email me</a>
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener" data-ga="contact_click" data-ga-method="linkedin">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>
