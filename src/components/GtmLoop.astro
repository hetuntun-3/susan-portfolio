---
// "GTM loop" strip at the top of a case page: how the projects below map to
// research → positioning → channels → measure, and which target role each stage shows.
// Only list stages the work really covered, with facts that appear further down the page.
interface Stage { stage: string; role: string; text: string; href: string }
interface Props { stages: Stage[] }
const { stages } = Astro.props;
---
<section class="gtm-loop" aria-labelledby="gtm-loop-title">
  <p class="gtm-head"><span id="gtm-loop-title">the gtm loop</span><span>how this work fits, stage by stage</span></p>
  <ol class="gtm-stages">
    {stages.map((s, i) => (
      <li class="gtm-stage">
        <a href={s.href}>
          <span class="gtm-top"><span class="gtm-n">{String(i + 1).padStart(2, '0')}</span><span class="gtm-name">{s.stage}</span></span>
          <span class="gtm-text">{s.text}</span>
          <span class="gtm-role">{s.role}</span>
        </a>
      </li>
    ))}
  </ol>
</section>
<style>
  .gtm-loop { margin:32px 0 0; }
  .gtm-head { display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 16px; margin:0 0 12px !important; font:var(--f-label) !important; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); }
  .gtm-head span:first-child { color:var(--ink); font-weight:600; }
  .gtm-stages { list-style:none; margin:0; padding:0 6px 6px 0; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); counter-reset:none; }
  .gtm-stage { min-width:0; position:relative; }
  .gtm-stage a { height:100%; display:flex; flex-direction:column; gap:10px; padding:18px; background:var(--surface); border:var(--border); color:var(--ink); text-decoration:none; transition:background .2s cubic-bezier(.4,0,.2,1), transform .2s cubic-bezier(.4,0,.2,1); }
  .gtm-stage + .gtm-stage a { border-left:0; }
  .gtm-stage + .gtm-stage::before { content:'→'; position:absolute; left:-9px; top:16px; width:18px; text-align:center; background:var(--surface); font:var(--f-small); color:var(--muted); z-index:1; }
  .gtm-stage a:hover, .gtm-stage a:focus-visible { background:var(--wash); }
  .gtm-top { display:flex; gap:8px; align-items:baseline; }
  .gtm-n { font:var(--f-label); color:var(--muted); }
  .gtm-name { font:var(--f-h3); font-size:20px; }
  .gtm-text { font:var(--f-small); flex:1; }
  .gtm-role { align-self:flex-start; font:var(--f-label); text-transform:uppercase; letter-spacing:.06em; padding:3px 8px; background:var(--wash); border:1px solid var(--rule-soft, currentColor); }
  @media (max-width:819px) {
    .gtm-stages { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .gtm-stage:nth-child(3) a { border-left:var(--border); }
    .gtm-stage:nth-child(n+3) a { border-top:0; }
    .gtm-stage:nth-child(3)::before { display:none; }
  }
  @media (max-width:480px) {
    .gtm-stages { grid-template-columns:minmax(0,1fr); }
    .gtm-stage + .gtm-stage a { border-left:var(--border); border-top:0; }
    .gtm-stage + .gtm-stage::before { display:none; }
  }
  @media (prefers-reduced-motion: reduce) { .gtm-stage a { transition:none; } }
</style>
