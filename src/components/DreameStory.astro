---
import DormSketch from './DormSketch.astro';
import ChapterBar from './ChapterBar.astro';
const chapters = [
  { id: 'd-bts', n: '01', name: 'Back-to-School campaign', short: 'Back-to-School' },
  { id: 'd-pitch', n: '02', name: 'Father’s Day pitching', short: 'Father’s Day' },
  { id: 'd-launch', n: '03', name: 'Launch PR', short: 'Launch PR' },
  { id: 'd-monitor', n: '04', name: 'Media monitoring', short: 'Monitoring' },
];
---
<div class="case-story container dreame-story">
  <nav class="project-index" aria-label="Projects on this page">
    {chapters.map((c) => <a href={`#${c.id}`}><span>{c.n}</span>{c.name}</a>)}
  </nav>

  <ChapterBar caseName="Dreame" chapters={chapters} />

  <section class="story-section project" id="d-bts" aria-labelledby="dreame-bts">
    <p class="project-tag">01 · campaign</p>
    <h2 id="dreame-bts">Back-to-School campaign</h2>
    <p class="lede">Dreame’s U.S. back-to-school push, aimed at students and the parents buying for them. My work had two parts:</p>
    <ol class="did-list">
      <li><a href="#d-bts-partners"><span>1</span><em><strong>Partnerships</strong> with creators, student associations, and journalists</em></a></li>
      <li><a href="#d-bts-concepts"><span>2</span><em><strong>Social post concepts</strong>, from the core idea to four post mockups</em></a></li>
    </ol>

    <h3 class="sub-head" id="d-bts-partners"><span class="sub-num">1</span>Partnerships</h3>
    <div class="partner-grid">
      <article class="partner-card">
        <span class="step-num">creators</span>
        <p class="partner-num"><strong>40+</strong><i>→</i><strong>8</strong></p>
        <p>Screened nano creators (under 10K followers, real comment sections), then wrote briefs for 8 product-seeding partners.</p>
      </article>
      <article class="partner-card">
        <span class="step-num">student associations</span>
        <p class="partner-num"><strong>USC</strong></p>
        <p>Proposed a new channel: student associations near Dreame’s California stores, posting for the brand in exchange for product. Landed a partnership with a USC student association.</p>
      </article>
      <article class="partner-card">
        <span class="step-num">journalists</span>
        <p class="partner-num"><strong>600</strong></p>
        <p>Pitched the campaign to 600 journalists across three segments: parenting, lifestyle, and tech.</p>
      </article>
    </div>

    <h3 class="sub-head" id="d-bts-concepts"><span class="sub-num">2</span>Social post concepts</h3>
    <p>The brand theme was “Reset Smarter, Live Cleaner.” Drawing on my own move-in, I proposed an emotional layer that spoke to both audiences:</p>
    <div class="audience-split">
      <div class="concept-band">
        <span class="step-num">my concept</span>
        <p class="concept-line">The care that stays with you.</p>
      </div>
      <div class="audience-tabs" role="tablist" aria-label="Audience" hidden>
        <button type="button" role="tab" id="aud-tab-students" aria-controls="aud-students" aria-selected="true">for students</button>
        <button type="button" role="tab" id="aud-tab-parents" aria-controls="aud-parents" aria-selected="false" tabindex="-1">for parents</button>
        <span class="tab-ink" aria-hidden="true"></span>
      </div>
      <div class="side" id="aud-students" role="tabpanel" aria-labelledby="aud-tab-students">
        <span class="step-num">for students</span>
        <h3>Confidence</h3>
        <p>A new semester is a glow-up moment. The hair dryer becomes part of a daily confidence routine: fast, aesthetic, and affordable.</p>
      </div>
      <div class="side" id="aud-parents" role="tabpanel" aria-labelledby="aud-tab-parents">
        <span class="step-num">for parents</span>
        <h3>Care from afar</h3>
        <p>The robot vacuum becomes a quiet helper that keeps cleaning up after them, the way a parent would.</p>
      </div>
    </div>

    <p class="mini-head">The data behind it</p>
    <ol class="data-steps">
      <li><strong>26%</strong><span>of back-to-school shoppers started by early June, up from 17% in 2019</span><em>→ launch early-bird promos</em></li>
      <li><strong>~1 in 2</strong><span>families buy in phases instead of all at once</span><em>→ offer phased-purchase guidance</em></li>
      <li><strong>76%</strong><span>of shoppers expected to spend more than the year before</span><em>→ lead with value and flexible pricing</em></li>
    </ol>
    <p class="work-caption">Source: National Retail Federation, 2025 back-to-school research. I summarized it and shared these recommendations with the team.</p>

    <p class="mini-head">Four posts, from dorm humor to a student offer <span class="tap-hint">· tap a post to enlarge</span></p>
    <div class="concept-grid">
      <article class="concept-card">
        <div class="mockup dorm-meme" aria-label="Illustrative dorm realities meme concept">
          <div class="meme-pair"><div><span>move-in day</span><DormSketch /></div><div><span>one week later</span><DormSketch messy /></div></div>
          <div class="mock-punchline">Tiny room.<br />Big mess.</div>
        </div>
        <p class="sample-caption">01 — Make the problem relatable.</p>
      </article>
      <article class="concept-card">
        <div class="mockup main-character" aria-label="Illustrative main character cleaning concept">
          <div class="mock-display">Your room.<br />Your reset.</div>
          <DormSketch cleaning />
        </div>
        <p class="sample-caption">02 — Make the solution appealing.</p>
      </article>
      <article class="concept-card">
        <div class="mockup survival-kit" aria-label="Illustrative dorm survival kit carousel cover">
          <div class="mock-display">The dorm<br />survival kit.</div>
          <svg class="kit-drawing" viewBox="0 0 360 150" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M26 43L76 33L91 111L41 121ZM38 56L65 50M42 67L70 61M135 116V65H182V116ZM139 64L147 36H171L179 64M145 35V26H173V35M222 119L230 96H273L281 119ZM235 96V79M231 82Q212 61 228 54Q243 49 246 76Q248 41 263 48Q281 56 252 81M305 114V42H338V114ZM316 49H328M318 106H326"/><path d="M104 29V43M97 36H111M292 57V67M287 62H297"/></svg>
        </div>
        <p class="sample-caption">03 — Give students something to save.</p>
      </article>
      <article class="concept-card">
        <div class="mockup student-deal" aria-label="Illustrative student-ID offer poster concept, not a current offer">
          <span class="deal-extra">EXTRA</span><strong class="deal-number">10<span>%</span></strong>
          <span class="deal-detail">off with student ID</span>
          <span class="deal-ticket">small space. smarter start. ↗</span>
        </div>
        <p class="sample-caption">04 — Connect interest to an offer.</p>
      </article>
    </div>
    <p class="work-caption">Portfolio reconstructions of my unlaunched concepts. The student offer shown is historical. I also suggested formats (split-screen TikToks from the student’s and parent’s view) and gave feedback on the first key visual.</p>
  </section>

  <section class="story-section project" id="d-pitch" aria-labelledby="dreame-pitch">
    <p class="project-tag">02 · pr pitching</p>
    <h2 id="dreame-pitch">Father’s Day pitching</h2>
    <p>One Father’s Day lineup, from cordless vacuums under $350 to robot vacuums around $1,000. Instead of one generic pitch, I wrote three, one for each kind of outlet, each matching how that outlet’s readers see fatherhood.</p>
    <div class="pitch-grid">
      <article class="pitch-card">
        <span class="step-num">lifestyle &amp; ecommerce</span>
        <p class="subject">“Smart &amp; Stylish Father’s Day Picks: Gifts That Actually Get Used”</p>
        <p class="angle">Angle: design and practicality.</p>
      </article>
      <article class="pitch-card">
        <span class="step-num">men’s business &amp; tech</span>
        <p class="subject">“High-Performance Gifts for High-Performance Dads”</p>
        <p class="angle">Angle: efficiency. Delegation is a skill, even for floors.</p>
      </article>
      <article class="pitch-card">
        <span class="step-num">parenting</span>
        <p class="subject">“Thoughtful (and Useful!) Father’s Day Gifts for the Everyday Superdad”</p>
        <p class="angle">Angle: shared parenting. Less time vacuuming, more time playing.</p>
      </article>
    </div>
    <p class="so-what"><span>So what:</span> The products didn’t change. The dad did: the provider, the efficiency-minded professional, or the hands-on parent.</p>
    <p class="work-caption">I also wrote Mother’s Day pitches for the hair dryer line, and built a May–December calendar of U.S. cultural moments to time future pitches.</p>
  </section>

  <section class="story-section project" id="d-launch" aria-labelledby="dreame-launch">
    <p class="project-tag">03 · launch pr</p>
    <h2 id="dreame-launch">Launch PR</h2>
    <p>I drafted launch pitches for the AirPursue PM 20 air purifier, supported the press release for the Santa Clara store opening, and ran PR outreach and logistics for the San Diego flagship launch.</p>
    <ul class="stat-grid three">
      <li><strong>100+</strong><span>attendees at the San Diego flagship launch</span></li>
      <li><strong>5+</strong><span>media and creator partners</span></li>
      <li><strong>20+</strong><span>earned-media placements</span></li>
    </ul>
  </section>

  <section class="story-section project" id="d-monitor" aria-labelledby="dreame-monitor">
    <p class="project-tag">04 · media monitoring</p>
    <h2 id="dreame-monitor">Media monitoring</h2>
    <p>Every Friday I sent a combined coverage report on Dreame and 6 competitors (Dyson, Shark, iRobot, Roborock, Tineco, Anker), tracking sentiment and share of voice in Meltwater, plus monthly competitor PR reports. I refined search queries with keyword exclusions to cut irrelevant coverage, and kept our journalist list segmented by beat.</p>
    <ul class="stat-grid two">
      <li><strong>6</strong><span>competitors tracked weekly in Meltwater</span></li>
      <li><strong>600+</strong><span>journalists on the media list I built, segmented by tech, lifestyle, and parenting</span></li>
    </ul>
  </section>

  <section class="story-section closing" aria-labelledby="dreame-outcome">
    <h2 id="dreame-outcome">Outcome &amp; reflection</h2>
    <p><strong class="key-number">8 creators</strong> received the G10, and the campus partnership with USC went ahead. The social plan was shelved during a team restructure, so reach and sales results were unavailable to me.</p>
    <details class="case-reflection">
      <summary>Reflection &amp; what I’d do next <span aria-hidden="true">+</span></summary>
      <div class="reflection-copy">
        <h3>Turn the insight into a test.</h3>
        <p>I had a clear two-audience insight and trend data behind it, but no way to see which message worked. Next time I’d run the student and parent angles against each other, two versions of the same post, before committing budget to either.</p>
        <h3>Connect creator selection to conversion.</h3>
        <p>Audience fit and genuine engagement helped me build the shortlist, but product seeding alone doesn’t show business impact. I’d give each creator a unique link or code and agree on a reporting window before sending products.</p>
      </div>
    </details>
  </section>

  <!-- Post viewer: opens when a mockup is tapped -->
  <dialog class="post-viewer" aria-label="Post concept viewer">
    <div class="pv-top">
      <span class="pv-count">01 / 04</span>
      <button type="button" class="pv-close" aria-label="Close">close ✕</button>
    </div>
    <div class="pv-stage"></div>
    <div class="pv-bottom">
      <button type="button" class="pv-prev" aria-label="Previous post">←</button>
      <p class="pv-caption"></p>
      <button type="button" class="pv-next" aria-label="Next post">→</button>
    </div>
  </dialog>
</div>

<style>
  /* ===== Dreame type + color system (preview) =====
     Serif: 32 section · 24 sub-head · 40 numbers (page title 56 lives in the banner).
     Mono: 15 body · 13 small · 12 uppercase labels. Weights: 400 and 600 only.
     Fills: lavender block, one lavender wash, white, plus accent tint on the offer post.
     Shadows: 10px for big panels, 6px for small cards, always lavender. */
  .lede { font:var(--f-body) !important; }
  .step-num, .project-tag, .mini-head { font:var(--f-label) !important; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); }
  .project-tag { margin:0 0 10px !important; }
  .mini-head { margin-top:40px !important; margin-bottom:16px !important; }

  /* "my work had two parts" list */
  .did-list { list-style:none; padding:0; max-width:var(--read,760px); margin:16px auto 0; display:grid; gap:8px; }
  .did-list a { display:flex; align-items:baseline; gap:14px; padding:12px 16px; border:var(--rule); background:var(--surface); color:var(--ink); text-decoration:none; font:var(--f-body); transition:background .2s, transform .2s; }
  .did-list a:hover { background:var(--wash); transform:translateX(4px); }
  .did-list span { font:var(--f-h3); }
  .did-list strong { font-weight:600; }
  .did-list em { font-style:normal; }
  .sub-head { display:flex; align-items:center; gap:12px; scroll-margin-top:88px; font:var(--f-h3) !important; max-width:var(--read,760px); margin:48px auto 16px !important; padding-top:20px; border-top:1px solid var(--rule-soft); }
  .sub-num { display:inline-grid; place-items:center; width:38px; height:38px; border:var(--border); background:var(--block); font:var(--f-h3); flex-shrink:0; }

  /* partnership cards */
  .partner-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; padding-right:6px; margin-top:20px; }
  .partner-card { background:var(--surface); border:var(--border); box-shadow:var(--sh-sm); padding:22px; display:flex; flex-direction:column; gap:10px; min-width:0; }
  .partner-num { display:flex; align-items:baseline; gap:10px; margin:0 !important; }
  .partner-num strong { font:var(--f-num); letter-spacing:-.02em; }
  .partner-num i { font-style:normal; font:var(--f-body); color:var(--muted); }
  .partner-card > p:not(.partner-num) { font:var(--f-small) !important; padding-top:10px; border-top:1px solid var(--rule-soft); }

  .case-story .project { scroll-margin-top:72px; }

  /* concept + audience tabs */
  .audience-split { display:grid; grid-template-columns:1fr 1fr; background:var(--surface); border:var(--border); box-shadow:var(--sh-lg); margin-right:10px; }
  .concept-band { grid-column:1 / -1; padding:24px 28px; background:var(--wash); border-bottom:var(--rule); text-align:center; }
  .concept-line { font:600 32px/1.15 var(--font-display) !important; letter-spacing:-.01em; margin:8px auto 0 !important; max-width:none !important; }
  .audience-split .side { padding:24px 28px; display:flex; flex-direction:column; gap:8px; }
  .audience-split .side + .side { border-left:var(--rule); }
  .audience-split h3 { font:var(--f-h3); margin:0; }
  .audience-split .side p { font:var(--f-body) !important; }
  /* with JS: one audience at a time */
  .audience-split.tabbed { grid-template-columns:1fr; }
  .audience-split.tabbed .side + .side { border-left:0; }
  .audience-split.tabbed .side[hidden] { display:none; }
  .audience-split.tabbed .side .step-num { display:none; }
  .audience-split.tabbed .side { text-align:center; align-items:center; padding:28px 32px 32px; min-height:170px; justify-content:center; }
  .audience-split.tabbed .side p { max-width:52ch !important; }
  .audience-tabs { position:relative; display:grid; grid-template-columns:1fr 1fr; border-bottom:var(--rule); }
  .audience-tabs[hidden] { display:none; }
  .audience-tabs button { position:relative; z-index:1; min-height:48px; border:0; background:none; cursor:pointer; font:var(--f-label); text-transform:uppercase; letter-spacing:.07em; color:var(--muted); transition:color .25s; }
  .audience-tabs button + button { border-left:var(--rule); }
  .audience-tabs button[aria-selected="true"] { color:var(--ink); font-weight:600; }
  .audience-tabs button:hover { color:var(--ink); }
  .tab-ink { position:absolute; left:0; bottom:-1px; width:50%; height:3px; background:var(--ink); transition:transform .35s cubic-bezier(.65,0,.35,1); }
  .audience-tabs[data-active="1"] .tab-ink { transform:translateX(100%); }
  @media (prefers-reduced-motion: no-preference) {
    .audience-split.tabbed .side:not([hidden]) > * { animation:aud-in .45s cubic-bezier(.165,.84,.44,1) both; }
    .audience-split.tabbed .side:not([hidden]) > p { animation-delay:.06s; }
    @keyframes aud-in { from { opacity:0; transform:translateY(10px); } }
  }

  /* NRF data cards */
  .data-steps { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; padding-right:6px; }
  .data-steps li { background:var(--surface); border:var(--border); box-shadow:var(--sh-sm); padding:22px; display:flex; flex-direction:column; gap:8px; min-width:0; }
  .data-steps strong, .stat-grid strong { font:var(--f-num); letter-spacing:-.02em; }
  .data-steps span, .stat-grid span { font:var(--f-small); }
  .data-steps em { font:600 13px/1.5 var(--font-mono); font-style:normal; color:var(--accent); margin-top:auto; padding-top:10px; border-top:1px solid var(--rule-soft); }

  /* stat panels */
  .stat-grid { list-style:none; padding:0; display:grid; background:var(--surface); border:var(--border); box-shadow:var(--sh-lg); margin-right:10px; }
  .stat-grid.three { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .stat-grid.two { grid-template-columns:repeat(2,minmax(0,1fr)); max-width:640px; margin-left:auto; margin-right:auto; }
  .stat-grid li { padding:22px; display:flex; flex-direction:column; gap:8px; min-width:0; }
  .stat-grid li + li { border-left:var(--rule); }

  /* Father's Day pitch cards: white, told apart by their label */
  .pitch-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; padding-right:6px; }
  .pitch-card { background:var(--surface); border:var(--border); box-shadow:var(--sh-sm); padding:22px; display:flex; flex-direction:column; gap:12px; min-width:0; transition:transform .2s, box-shadow .2s; }
  .pitch-card:hover { transform:translate(-3px,-3px); box-shadow:9px 9px 0 var(--block); }
  .pitch-card .subject { font:var(--f-h3) !important; max-width:none !important; }
  .pitch-card .angle { font:var(--f-small) !important; margin-top:auto !important; padding-top:10px; border-top:1px solid var(--rule-soft); max-width:none !important; }
  .so-what { margin-top:28px !important; padding-left:16px; border-left:3px solid var(--accent); font-weight:600 !important; }
  .so-what span { color:var(--accent); }

  /* post mockups (artwork keeps its own display sizes) */
  .case-story .concept-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px 24px; padding-right:6px; }
  .concept-card { min-width:0; }
  .case-story .mockup { position:relative; height:330px; padding:24px; border:var(--border); box-shadow:var(--sh-sm); overflow:hidden; display:flex; flex-direction:column; }
  .dorm-meme { background:var(--wash); }
  .meme-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
  .meme-pair > div { border:var(--rule); background:var(--surface); }
  .meme-pair span { display:block; padding:6px; border-bottom:var(--rule); font:var(--f-label); text-align:center; }
  .meme-pair :global(svg) { display:block; width:100%; max-height:110px; }
  .mock-punchline,.mock-display { font:600 42px/1.08 var(--font-display); margin-top:24px; letter-spacing:-.02em; }
  .main-character { background:var(--block); }
  .main-character :global(svg) { position:absolute; width:78%; right:12px; bottom:16px; }
  .survival-kit { background:var(--surface); }
  .kit-drawing { width:100%; margin:auto 0; }
  .student-deal { background:var(--accent-tint); align-items:center; justify-content:center; text-align:center; }
  .deal-extra { font:var(--f-label); letter-spacing:.1em; }
  .deal-number { font:600 104px/1 var(--font-display); letter-spacing:-.06em; }
  .deal-number span { font-size:54px; }
  .deal-detail { font:var(--f-body); margin-top:10px; }
  .deal-ticket { border:var(--rule); padding:8px 12px; transform:rotate(-4deg); font:var(--f-label); margin-top:24px; background:var(--paper); }
  .tap-hint { text-transform:none; letter-spacing:0; }
  /* tappable mockups */
  .case-story .mockup.zoomable { cursor:zoom-in; transition:transform .25s cubic-bezier(.165,.84,.44,1), box-shadow .25s; }
  .case-story .mockup.zoomable:hover { transform:translate(-3px,-3px); box-shadow:9px 9px 0 var(--block); }
  .case-story .mockup.zoomable::after { content:'enlarge ⤢'; position:absolute; right:12px; top:12px; padding:5px 9px; border:var(--rule); background:var(--surface); font:var(--f-label); opacity:0; transform:translateY(-4px); transition:opacity .2s, transform .2s; }
  .case-story .mockup.zoomable:hover::after, .case-story .mockup.zoomable:focus-visible::after { opacity:1; transform:none; }

  /* post viewer dialog */
  .post-viewer { width:min(920px, 94vw); max-height:94vh; padding:0; border:var(--border); background:var(--paper); box-shadow:12px 12px 0 var(--block); overflow:hidden; }
  .post-viewer::backdrop { background:rgba(20,20,20,.55); }
  .pv-top, .pv-bottom { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:12px 16px; }
  .pv-top { border-bottom:var(--rule); }
  .pv-bottom { border-top:var(--rule); }
  .pv-count { font:var(--f-label); letter-spacing:.07em; color:var(--muted); }
  .pv-close, .pv-prev, .pv-next { min-height:44px; min-width:44px; padding:0 12px; border:var(--border); background:var(--surface); cursor:pointer; font:var(--f-body); color:var(--ink); }
  .pv-close:hover, .pv-prev:hover, .pv-next:hover { background:var(--wash); }
  .pv-caption { margin:0 !important; text-align:center; font:var(--f-body) !important; }
  .pv-stage { display:grid; place-items:center; padding:24px; overflow:hidden; }
  .pv-stage :global(.pv-frame) { position:relative; }
  .pv-stage :global(.pv-frame > .mockup) { position:absolute !important; top:0; left:0; transform-origin:0 0; margin:0; box-shadow:none !important; cursor:default !important; }
  .pv-stage :global(.pv-frame > .mockup::after) { display:none; }
  @media (prefers-reduced-motion: no-preference) {
    .post-viewer[open] { animation:pv-in .35s cubic-bezier(.165,.84,.44,1); }
    .post-viewer[open]::backdrop { animation:pv-fade .3s ease; }
    :global(.pv-frame.slide-next) { animation:pv-next .35s cubic-bezier(.165,.84,.44,1); }
    :global(.pv-frame.slide-prev) { animation:pv-prev .35s cubic-bezier(.165,.84,.44,1); }
    @keyframes pv-in { from { opacity:0; transform:translateY(16px) scale(.97); } }
    @keyframes pv-fade { from { opacity:0; } }
    @keyframes pv-next { from { opacity:0; transform:translateX(40px); } }
    @keyframes pv-prev { from { opacity:0; transform:translateX(-40px); } }
  }

  @media(max-width:819px) {
    .partner-grid { grid-template-columns:1fr; }
    .audience-split { grid-template-columns:1fr; } .audience-split .side + .side { border-left:0; border-top:var(--rule); }
    .audience-split.tabbed .side + .side { border-top:0; }
    .data-steps, .pitch-grid { grid-template-columns:1fr; }
    .stat-grid.three { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .stat-grid.three li + li:nth-child(3) { border-left:0; } .stat-grid li:nth-child(n+3) { border-top:var(--rule); }
    .concept-line { font-size:26px !important; }
  }
  @media(max-width:420px) { .stat-grid li, .data-steps li { padding:18px 16px; } .stat-grid strong, .data-steps strong { font-size:32px; } }
  @media(max-width:699px) { .case-story .concept-grid { grid-template-columns:minmax(0,1fr); } .case-story .mockup { height:310px; } .mock-punchline,.mock-display { font-size:36px; } .pv-stage { padding:12px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.dreame-story');
  if (root) {
    /* ---- audience tabs ---- */
    const split = root.querySelector<HTMLElement>('.audience-split')!;
    const tabsEl = split.querySelector<HTMLElement>('.audience-tabs')!;
    const tabs = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    tabsEl.hidden = false;
    split.classList.add('tabbed');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
      tabsEl.dataset.active = String(i);
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); select((i + 1) % tabs.length, true); }
      });
    });
    select(0);

    /* ---- post viewer ---- */
    const dialog = root.querySelector<HTMLDialogElement>('.post-viewer')!;
    const stage = dialog.querySelector<HTMLElement>('.pv-stage')!;
    const count = dialog.querySelector<HTMLElement>('.pv-count')!;
    const caption = dialog.querySelector<HTMLElement>('.pv-caption')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.concept-card'));
    let at = 0;
    const show = (i: number, dir = 0) => {
      at = (i + cards.length) % cards.length;
      const src = cards[at].querySelector<HTMLElement>('.mockup')!;
      const w = src.offsetWidth, h = src.offsetHeight;
      const clone = src.cloneNode(true) as HTMLElement;
      clone.classList.remove('zoomable');
      clone.removeAttribute('tabindex'); clone.removeAttribute('role');
      clone.style.width = w + 'px'; clone.style.height = h + 'px';
      const maxW = stage.clientWidth - 48, maxH = window.innerHeight * 0.94 - 190;
      const s = Math.max(0.5, Math.min(maxW / w, maxH / h, 2.2));
      clone.style.transform = `scale(${s})`;
      const frame = document.createElement('div');
      frame.className = 'pv-frame' + (dir > 0 ? ' slide-next' : dir < 0 ? ' slide-prev' : '');
      frame.style.width = w * s + 'px'; frame.style.height = h * s + 'px';
      frame.append(clone);
      stage.replaceChildren(frame);
      count.textContent = `${String(at + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      caption.textContent = cards[at].querySelector('.sample-caption')?.textContent?.replace(/^\d+\s—\s/, '') ?? '';
    };
    let opener: HTMLElement | null = null;
    cards.forEach((card, i) => {
      const m = card.querySelector<HTMLElement>('.mockup')!;
      m.classList.add('zoomable');
      m.tabIndex = 0;
      m.setAttribute('role', 'button');
      m.setAttribute('aria-label', `Enlarge post ${i + 1}: ${m.getAttribute('aria-label') ?? ''}`);
      const open = () => { opener = m; dialog.showModal(); show(i); };
      m.addEventListener('click', open);
      m.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });
    dialog.querySelector('.pv-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.pv-prev')!.addEventListener('click', () => show(at - 1, -1));
    dialog.querySelector('.pv-next')!.addEventListener('click', () => show(at + 1, 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1, 1);
      if (e.key === 'ArrowLeft') show(at - 1, -1);
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener?.focus());
    // swipe on touch screens
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });
  }
</script>
