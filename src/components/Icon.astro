---
// Simple line icons that "draw themselves" when their card scrolls into view.
// Every path uses pathLength="1" so the draw animation works the same for each.
interface Props { name: string }
const { name } = Astro.props;
---
<svg class="ico" viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'pattern' && (
    <>
      <circle cx="20" cy="20" r="12" pathLength="1" />
      <path d="M29 29 L41 41" pathLength="1" />
      <path d="M14 24 L18 18 L22 21 L27 14" pathLength="1" class="accent" />
    </>
  )}
  {name === 'trust' && (
    <>
      <path d="M6 10 H30 V26 H16 L10 32 V26 H6 Z" pathLength="1" />
      <path d="M22 30 V34 H32 L38 40 V34 H42 V18 H34" pathLength="1" />
      <path d="M13 18 H23" pathLength="1" class="accent" />
    </>
  )}
  {name === 'measure' && (
    <>
      <path d="M6 6 V42 H42" pathLength="1" />
      <path d="M14 36 V28" pathLength="1" />
      <path d="M23 36 V22" pathLength="1" />
      <path d="M32 36 V16" pathLength="1" />
      <path d="M12 22 L22 15 L30 18 L40 8" pathLength="1" class="accent" />
    </>
  )}
  {name === 'subtext' && (
    <>
      <path d="M4 24 C11 13 18 10 24 10 C30 10 37 13 44 24 C37 35 30 38 24 38 C18 38 11 35 4 24 Z" pathLength="1" />
      <circle cx="24" cy="24" r="7" pathLength="1" class="accent" />
    </>
  )}
  {name === 'audience' && (
    <>
      <circle cx="12" cy="16" r="5" pathLength="1" />
      <path d="M4 36 C4 28 8 25 12 25 C16 25 20 28 20 36" pathLength="1" />
      <circle cx="28" cy="16" r="5" pathLength="1" />
      <path d="M20 36 C20 28 24 25 28 25 C32 25 36 28 36 36" pathLength="1" />
      <circle cx="41" cy="20" r="4" pathLength="1" class="accent dashed" />
    </>
  )}
  {name === 'story' && (
    <>
      <path d="M10 4 H30 L38 12 V44 H10 Z" pathLength="1" />
      <path d="M30 4 V12 H38" pathLength="1" />
      <path d="M16 22 H32 M16 29 H32" pathLength="1" />
      <path d="M16 36 H25" pathLength="1" class="accent" />
    </>
  )}
</svg>
