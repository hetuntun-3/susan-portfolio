---
// Project card used on Home and /work.
// Cover: a real photo if `cover` is set (only approved images), otherwise a
// typography cover built from verified facts in the case file (coverKicker / coverTitle / coverSteps / coverNote).
interface Props {
  entry: {
    id: string;
    data: {
      title: string; timeline: string; tag: string; block: string; comingSoon: boolean;
      cover?: string; coverAlt?: string; coverPosition?: string;
      coverKicker?: string; coverTitle?: string; coverSteps?: string[]; coverNote?: string;
      summary?: string; metrics?: string[];
    };
  };
}
const { entry } = Astro.props;
const d = entry.data;
const style = `--block: var(--block-${d.block})`;
const Tag = d.comingSoon ? 'div' : 'a';
---
<Tag
  class={`card pcard${d.comingSoon ? ' soon' : ''}`}
  href={d.comingSoon ? undefined : `/work/${entry.id}`}
  aria-disabled={d.comingSoon ? 'true' : undefined}
  style={style}
>
  <div class="label">{d.timeline}</div>
  <div class="card-title">{d.title}</div>

  <div class="pcover">
    {d.cover ? (
      <img src={d.cover} alt={d.coverAlt ?? ''} loading="lazy" style={d.coverPosition ? `object-position:${d.coverPosition}` : undefined} />
    ) : (
      <div class="pc-type" aria-hidden="true">
        {d.coverKicker && <span class="pc-kicker">{d.coverKicker}</span>}
        {d.coverTitle && <span class="pc-title">{d.coverTitle}</span>}
        {d.coverSteps && d.coverSteps.length > 0 && (
          <ol class="pc-steps">{d.coverSteps.map((s) => <li>{s}</li>)}</ol>
        )}
        {d.coverNote && <span class="pc-note">{d.coverNote}</span>}
      </div>
    )}
  </div>

  <div class="pbody">
    <p class="psum">{d.summary ?? d.tag}</p>
    {d.metrics && d.metrics.length > 0 && (
      <ul class="pmetrics">{d.metrics.map((m) => <li>{m}</li>)}</ul>
    )}
    {d.comingSoon ? (
      <span class="badge progress">In progress</span>
    ) : (
      <span class="pmore">read the case →</span>
    )}
  </div>
</Tag>
